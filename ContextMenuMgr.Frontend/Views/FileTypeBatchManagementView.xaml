<UserControl
    x:Class="ContextMenuMgr.Frontend.Views.FileTypeBatchManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernScroll="clr-namespace:ContextMenuMgr.Frontend.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ContextMenuMgr.Frontend.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource LayerFillColorAltBrush}"
            Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Border
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="6"
                            DockPanel.Dock="Left">
                            <Image
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{Binding SourceItem.IconSource}"
                                Stretch="Uniform" />
                        </Border>
                        <ui:TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ui:TextBlock
                        Margin="0,6,0,0"
                        Opacity="0.78"
                        Text="{Binding IdentityText}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,6,0,0"
                        Opacity="0.72"
                        Text="{Binding CountText}" />
                    <ui:TextBlock Margin="0,4,0,0" Text="{Binding ProgressText}" />
                    <ui:TextBlock Margin="0,4,0,0" Text="{Binding ResultText}" TextWrapping="Wrap" />
                    <ui:TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        Opacity="0.65"
                        Text="{Binding SourceRegistryPathLabel}" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        FontFamily="Consolas"
                        FontSize="11"
                        Opacity="0.72"
                        Text="{Binding SourceRegistryPath}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <WrapPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right">
                    <ui:Button
                        Margin="0,0,8,8"
                        Padding="12,5"
                        Appearance="Secondary"
                        Command="{Binding BackCommand}"
                        Content="{Binding BackText}"
                        Icon="{ui:SymbolIcon Symbol=ArrowLeft24}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Padding="12,5"
                        Appearance="Secondary"
                        Command="{Binding RefreshCommand}"
                        Content="{Binding RefreshText}"
                        Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Padding="12,5"
                        Command="{Binding DisableAllCommand}"
                        Content="{Binding DisableAllText}"
                        Icon="{ui:SymbolIcon Symbol=DismissCircle24}" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Padding="12,5"
                        Command="{Binding EnableAllCommand}"
                        Content="{Binding EnableAllText}"
                        Icon="{ui:SymbolIcon Symbol=CheckmarkCircle24}" />
                    <ui:Button
                        Margin="0,0,0,8"
                        Padding="12,5"
                        Appearance="Secondary"
                        Command="{Binding DeleteAllCommand}"
                        Content="{Binding DeleteAllText}"
                        Icon="{ui:SymbolIcon Symbol=Delete24}" />
                    <ui:Button
                        Margin="8,0,0,8"
                        Padding="12,5"
                        Appearance="Secondary"
                        Command="{Binding UndoAllCommand}"
                        Content="{Binding UndoAllText}"
                        Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                    <ui:Button Margin="8,0,0,8" Padding="12,5"
                        Command="{Binding CancelBatchCommand}" Content="{Binding CancelText}" />
                </WrapPanel>
            </Grid>
        </Border>

        <modernScroll:ModernScrollViewer Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ActionGroups}" IsEnabled="{Binding CanEditBatchRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:FileTypeBatchActionGroup}">
                            <Expander Margin="0,8,0,0" Padding="8"
                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                            ToolTip="{Binding Evidence}" />
                                        <ui:TextBlock Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <ui:TextBlock Margin="8,0,0,0" Opacity="0.7"
                                            Text="{Binding Count, StringFormat='({0})'}" />
                                        <ui:TextBlock Margin="12,0,0,0" Opacity="0.7"
                                            Text="{Binding Evidence}" />
                                    </StackPanel>
                                </Expander.Header>
                                <ListBox ItemsSource="{Binding Registrations}" MaxHeight="360"
                                    ScrollViewer.CanContentScroll="True"
                                    VirtualizingStackPanel.IsVirtualizing="True"
                                    VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:FileTypeBatchRegistration}">
                                            <Grid Margin="0,4,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <ui:TextBlock Text="{Binding Item.FileTypeRegistrationSource}"
                                                        FontWeight="SemiBold" />
                                                    <ui:TextBlock Text="{Binding Item.Entry.BackendRegistryPath}"
                                                        FontFamily="Consolas" FontSize="11"
                                                        TextWrapping="Wrap" />
                                                    <ui:TextBlock Text="{Binding Item.StateLabel}"
                                                        Opacity="0.7" />
                                                    <ui:TextBlock Text="{Binding Evidence}"
                                                        Opacity="0.7" FontSize="11" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    Margin="12,0,0,0">
                                                    <ui:ToggleSwitch IsChecked="{Binding Item.IsEnabled, Mode=TwoWay}"
                                                        IsEnabled="{Binding Item.CanToggle}"
                                                        Visibility="{Binding Item.ShowToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ui:Button Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Item}"
                                                        Content="{Binding Item.PrimaryActionLabel}"
                                                        IsEnabled="{Binding Item.CanDeleteInFileTypeBatch}"
                                                        Visibility="{Binding Item.IsDeleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <ui:Button Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Item}"
                                                        Content="{Binding Item.PrimaryActionLabel}"
                                                        Visibility="{Binding Item.IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock Margin="24" HorizontalAlignment="Center"
                    Text="{Binding EmptyText}"
                    Visibility="{Binding ShowPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </modernScroll:ModernScrollViewer>
    </Grid>
</UserControl>
