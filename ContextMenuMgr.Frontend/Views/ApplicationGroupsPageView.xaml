<Page
    x:Class="ContextMenuMgr.Frontend.Views.ApplicationGroupsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:ContextMenuMgr.Frontend.Behaviors"
    xmlns:controls="clr-namespace:ContextMenuMgr.Frontend.Controls"
    xmlns:modernScroll="clr-namespace:ContextMenuMgr.Frontend.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ContextMenuMgr.Frontend.ViewModels"
    modernScroll:ModernScroll.Ownership="Self"
    Background="Transparent"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <DataTemplate DataType="{x:Type viewModels:ApplicationGroupViewModel}">
            <Border
                Margin="0,0,0,12"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:TextBlock Margin="0,4,10,4" VerticalAlignment="Center" Opacity="0.72" Text="{Binding SelectedCountText}" />
                        <ui:Button Margin="0,4,8,4" Padding="12,5" Appearance="Secondary"
                            Command="{Binding DeleteSelectedCommand}" Content="{Binding DeleteText}" Icon="{ui:SymbolIcon Symbol=Delete24}"
                            Visibility="{Binding HasLiveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button Margin="0,4,0,4" Padding="12,5" Appearance="Secondary"
                            Command="{Binding DisableSelectedCommand}" Content="{Binding DisableText}"
                            Visibility="{Binding HasLiveSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button Margin="8,4,0,4" Padding="12,5" Appearance="Secondary"
                            Command="{Binding RestoreSelectedCommand}" Content="{Binding RestoreText}" Icon="{ui:SymbolIcon Symbol=ArrowUndo24}"
                            Visibility="{Binding HasDeletedSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:Button Margin="8,4,0,4" Padding="12,5" Appearance="Secondary"
                            Command="{Binding PermanentlyDeleteSelectedCommand}" Content="{Binding PermanentDeleteText}" Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}"
                            Visibility="{Binding HasDeletedSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ui:ProgressRing Width="18" Height="18" Margin="10,4,0,4" VerticalAlignment="Center"
                            IsIndeterminate="True" Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                    <CheckBox
                        Grid.RowSpan="2"
                        Margin="2,4,12,0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding SelectAllText}"
                        ToolTip="{Binding SelectAllText}"
                        IsThreeState="True"
                        IsChecked="{Binding IsAllVisibleChecked, Mode=OneWay}"
                        Command="{Binding ToggleSelectionCommand}"
                        IsEnabled="{Binding DataContext.IsBulkIdle, RelativeSource={RelativeSource AncestorType=Page}}" />
                    <StackPanel Grid.Column="1">
                        <ui:TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding Identity}"
                            TextWrapping="Wrap" />
                        <ui:TextBlock
                            Margin="0,3,0,0"
                            Opacity="0.65"
                            Text="{Binding CountText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ContextMenuItemViewModel}">
            <Grid Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    Margin="2,10,10,0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding DisplayName}"
                    IsChecked="{Binding IsApplicationGroupChecked, Mode=TwoWay}"
                    IsEnabled="{Binding DataContext.IsBulkIdle, RelativeSource={RelativeSource AncestorType=Page}}" />
                <Border
                    Grid.Column="1"
                    IsEnabled="{Binding DataContext.IsBulkIdle, RelativeSource={RelativeSource AncestorType=Page}}"
                    Style="{StaticResource ContextMenuItemCardStyle}"
                    Tag="{Binding Id}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Opacity="{Binding CardOpacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="34"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <Image
                                        Margin="5"
                                        Source="{Binding IconSource}"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <WrapPanel>
                                        <ui:TextBlock
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="{Binding DisplayName}" />
                                        <Border Margin="8,0,0,0" Style="{StaticResource ContextMenuEnabledBadgeStyle}">
                                            <ui:TextBlock Style="{StaticResource ContextMenuEnabledBadgeTextStyle}" Text="{Binding StateLabel}" />
                                        </Border>
                                        <ui:Button
                                            Margin="10,0,0,0"
                                            Appearance="Secondary"
                                            Command="{Binding DeepAnalyzeMenuItemCommand}"
                                            Content="{Binding DeepAnalyzeMenuItemText}"
                                            ToolTip="{Binding DeepAnalyzeMenuItemTooltip}"
                                            Visibility="{Binding CanDeepAnalyzeMenuItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </WrapPanel>
                                    <ui:TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Opacity="0.65"
                                        Text="{Binding CategoryName}" />
                                    <ui:TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="11"
                                        Opacity="0.6"
                                        Text="{Binding KeyName}"
                                        Visibility="{Binding ShowKeyName, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            <ui:TextBlock
                                Margin="0,6,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                Opacity="0.72"
                                Text="{Binding RegistryPath}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Margin="0,6,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                Opacity="0.72"
                                Text="{Binding InlineCommandText}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ShowInlineCommandText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:TextBlock
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                Text="{Binding UserNoteDisplay}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasUserNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:TextBlock
                                Margin="0,8,0,0"
                                Opacity="0.78"
                                Text="{Binding Notes}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ShowDetailedNotes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right">
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <ui:Button
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Command="{Binding ManageSubMenuItemsCommand}"
                                    Icon="{ui:SymbolIcon Symbol=Apps24}"
                                    ToolTip="{Binding ManageSubMenuItemsToolTip}"
                                    Visibility="{Binding CanManageSubMenuItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <controls:AsyncToggleSwitch
                                    CanToggle="{Binding CanToggle}"
                                    IsBusy="{Binding IsToggleBusy}"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Label="{Binding ToggleLabel}"
                                    Visibility="{Binding ShowToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <ui:Button
                                MinWidth="88" Margin="0,0,0,8" Padding="12,5"
                                Command="{Binding DataContext.DeleteOrUndoItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Page}}"
                                Icon="{ui:SymbolIcon Symbol=Delete24}" IsEnabled="{Binding CanPrimaryAction}"
                                Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button
                                MinWidth="88" Margin="0,0,0,8" Padding="12,5"
                                Command="{Binding DataContext.DeleteOrUndoItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="{Binding DataContext.RestoreText, RelativeSource={RelativeSource AncestorType=Page}}"
                                Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" IsEnabled="{Binding CanPrimaryAction}"
                                Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button
                                MinWidth="88" Margin="0,0,0,8" Padding="12,5" Appearance="Secondary"
                                Command="{Binding DataContext.PermanentlyDeleteItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="{Binding DataContext.PermanentDeleteText, RelativeSource={RelativeSource AncestorType=Page}}"
                                Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}" IsEnabled="{Binding CanPrimaryAction}"
                                Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:DropDownButton
                                MinWidth="88"
                                Appearance="Secondary"
                                Content="{Binding MoreActionsText}"
                                Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}"
                                Visibility="{Binding HasActionFlyout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:DropDownButton.Flyout>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem
                                            behaviors:ClickOpenSubmenuBehavior.IsEnabled="True"
                                            Header="{Binding OtherAttributesTitle}"
                                            Visibility="{Binding HasOtherAttributesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuItem
                                                Header="{Binding OnlyWithShiftLabel}"
                                                IsCheckable="True"
                                                IsChecked="{Binding OnlyWithShift, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEditShellAttributes}"
                                                StaysOpenOnClick="True" />
                                            <MenuItem
                                                Header="{Binding OnlyInExplorerLabel}"
                                                IsCheckable="True"
                                                IsChecked="{Binding OnlyInExplorer, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEditShellAttributes}"
                                                StaysOpenOnClick="True" />
                                            <MenuItem
                                                Header="{Binding NoWorkingDirectoryLabel}"
                                                IsCheckable="True"
                                                IsChecked="{Binding NoWorkingDirectory, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEditShellAttributes}"
                                                StaysOpenOnClick="True" />
                                            <MenuItem
                                                Header="{Binding NeverDefaultLabel}"
                                                IsCheckable="True"
                                                IsChecked="{Binding NeverDefault, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEditShellAttributes}"
                                                StaysOpenOnClick="True" />
                                            <MenuItem
                                                Header="{Binding ShowAsDisabledIfHiddenLabel}"
                                                IsCheckable="True"
                                                IsChecked="{Binding ShowAsDisabledIfHidden, Mode=TwoWay}"
                                                IsEnabled="{Binding CanEditShellAttributes}"
                                                StaysOpenOnClick="True" />
                                        </MenuItem>
                                        <MenuItem
                                            behaviors:ClickOpenSubmenuBehavior.IsEnabled="True"
                                            Header="{Binding DetailsTitle}"
                                            Visibility="{Binding HasDetailsActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <MenuItem
                                                Command="{Binding EditUserNoteCommand}"
                                                Header="{Binding DetailsEditUserNoteLabel}"
                                                Visibility="{Binding CanEditUserNote, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding ChangeTextCommand}"
                                                Header="{Binding DetailsChangeTextLabel}"
                                                Visibility="{Binding CanEditText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding SearchOnlineCommand}"
                                                Header="{Binding DetailsSearchOnline}"
                                                Visibility="{Binding CanSearchOnline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding ShowCommandTextCommand}"
                                                Header="{Binding DetailsCommandTextLabel}"
                                                Visibility="{Binding ShowReadOnlyCommandText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding ChangeCommandTextCommand}"
                                                Header="{Binding DetailsChangeCommandLabel}"
                                                Visibility="{Binding CanEditCommandText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding OpenFilePropertiesCommand}"
                                                Header="{Binding DetailsFilePropertiesLabel}"
                                                Visibility="{Binding HasFileLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding OpenFileLocationCommand}"
                                                Header="{Binding DetailsFileLocationLabel}"
                                                Visibility="{Binding HasFileLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding OpenRegistryLocationCommand}"
                                                Header="{Binding DetailsRegistryLocationLabel}"
                                                Visibility="{Binding HasRegistryLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding ExportRegistryCommand}"
                                                Header="{Binding DetailsExportRegistryLabel}"
                                                Visibility="{Binding HasRegistryLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <MenuItem
                                                Command="{Binding OpenClsidLocationCommand}"
                                                Header="{Binding DetailsClsidLocationLabel}"
                                                Visibility="{Binding HasClsidLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </ui:DropDownButton.Flyout>
                            </ui:DropDownButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <StackPanel>
                <ui:TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="{Binding Title}" />
                <ui:TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.72"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBox
                Margin="0,18,0,14"
                Padding="10,7"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding SearchLabel}" />
            <Border
                Margin="0,0,0,14"
                Padding="12,8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6"
                Visibility="{Binding IsNavigationFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <ui:Button
                        Margin="12,0,0,0"
                        Appearance="Secondary"
                        Command="{Binding ClearNavigationFilterCommand}"
                        Content="{Binding ClearFilterText}"
                        DockPanel.Dock="Right" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.78"
                        Text="{Binding NavigationFilterBannerText}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="1">
            <ListBox
                x:Name="ApplicationRows"
                behaviors:MenuListTransitions.IsEnabled="True"
                behaviors:SuppressBringIntoViewBehavior.IsEnabled="True"
                Style="{StaticResource ModernVirtualizedListBoxStyle}" />
            <Border
                Padding="24,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="100"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False"
                Visibility="{Binding IsListLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MinWidth="180" HorizontalAlignment="Center">
                    <ProgressBar
                        Width="120"
                        Height="4"
                        IsIndeterminate="True" />
                    <ui:TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Opacity="0.86"
                        Text="{Binding LoadingText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ui:TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0.72"
                Text="{Binding NoItemsText}"
                TextWrapping="Wrap"
                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</Page>
