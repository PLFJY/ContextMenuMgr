<UserControl
    x:Class="ContextMenuMgr.Frontend.Views.SceneBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernScroll="clr-namespace:ContextMenuMgr.Frontend.Controls.Modern.Scrolling"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewModels="clr-namespace:ContextMenuMgr.Frontend.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{DynamicResource LayerFillColorAltBrush}"
            Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <ui:TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding Title}" />
                <ui:TextBlock
                    Margin="0,6,0,0"
                    Opacity="0.72"
                    Text="{Binding Description}"
                    TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ui:TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding DisplayModeText}" />
                    <RadioButton
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Content="{Binding CompactViewText}"
                        GroupName="SceneContextMenuListViewMode"
                        IsChecked="{Binding IsCompactView, Mode=TwoWay}"
                        ToolTip="{Binding CompactViewTooltip}" />
                    <RadioButton
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding DetailedViewText}"
                        GroupName="SceneContextMenuListViewMode"
                        IsChecked="{Binding IsDetailedView, Mode=TwoWay}"
                        ToolTip="{Binding DetailedViewTooltip}" />
                    <CheckBox
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="{Binding HideDisabledItemsText}"
                        IsChecked="{Binding HideDisabledItems, Mode=TwoWay}"
                        ToolTip="{Binding HideDisabledItemsText}" />
                    <ui:Button
                        Padding="14,6"
                        Command="{Binding AddMenuItemCommand}"
                        Content="{Binding AddMenuItemText}"
                        Icon="{ui:SymbolIcon Symbol=Add24}" />
                </WrapPanel>

                <StackPanel
                    Margin="0,12,0,0"
                    Visibility="{Binding HasTextSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding SelectorLabel}" />
                    <DockPanel>
                        <TextBox
                            MinWidth="260"
                            Margin="0,0,8,0"
                            Padding="10,6"
                            DockPanel.Dock="Left"
                            Text="{Binding ScopeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Padding="14,6"
                            Command="{Binding RefreshCommand}"
                            Content="{Binding SelectorButtonText}"
                            Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                    </DockPanel>
                </StackPanel>

                <StackPanel
                    Margin="0,12,0,0"
                    Visibility="{Binding HasOptionSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding SelectorLabel}" />
                    <ComboBox
                        MinWidth="260"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedOption}" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0">
                    <ui:TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        Opacity="0.72"
                        Text="{Binding SearchLabel}" />
                    <TextBox
                        MinWidth="260"
                        Padding="10,6"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <modernScroll:ModernScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl
                    Background="Transparent"
                    ItemsSource="{Binding ItemsView}">
                    <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ContextMenuItemViewModel}">
                        <Border
                            Margin="0,0,0,10"
                            Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorSecondaryBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorSecondaryBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDetectedChange}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Opacity="{Binding CardOpacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="28"
                                            Height="28"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource ControlFillColorTertiaryBrush}"
                                            BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Image
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{Binding IconSource}" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <WrapPanel>
                                                <ui:TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}" />
                                                <Border
                                                    Height="23"
                                                    Margin="8,0,0,0"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <ui:TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{Binding StateLabel}" />
                                                </Border>
                                                <Border
                                                    Height="23"
                                                    Margin="6,0,0,0"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding IsPendingApproval, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{Binding PendingApprovalBadgeText}" />
                                                </Border>
                                                <Border
                                                    Height="23"
                                                    Margin="6,0,0,0"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding HasDetectedChange, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ui:TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="{Binding DetectedChangeBadgeText}" />
                                                </Border>
                                            </WrapPanel>

                                            <ui:TextBlock
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="{Binding KeyName}">
                                                <ui:TextBlock.Style>
                                                    <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="ui:TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ShowKeyName}" Value="True" />
                                                                    <Condition Binding="{Binding DataContext.IsDetailedView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:TextBlock.Style>
                                            </ui:TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <ui:TextBlock
                                        Margin="38,3,0,0"
                                        Opacity="0.72"
                                        Text="{Binding CompactApplicationName}">
                                        <ui:TextBlock.Style>
                                            <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="ui:TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasCompactApplicationName}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBlock.Style>
                                    </ui:TextBlock>
                                    <StackPanel Visibility="{Binding DataContext.IsDetailedView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:TextBlock
                                            Margin="0,6,0,0"
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Opacity="0.72"
                                            Text="{Binding RegistryPath}" />
                                        <ui:TextBlock
                                            Margin="0,8,0,0"
                                            Opacity="0.78"
                                            Text="{Binding Notes}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding ShowNotes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ui:TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding DetectedChangeText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasDetectedChange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <DockPanel
                                        Margin="0,6,0,0"
                                        Visibility="{Binding CanDismissAttention, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:Button
                                            Width="22"
                                            Height="22"
                                            Margin="0,0,6,0"
                                            Padding="0"
                                            Appearance="Transparent"
                                            Command="{Binding DismissDetectedChangeCommand}"
                                            DockPanel.Dock="Right"
                                            Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                            ToolTip="{Binding DismissAttentionText}"
                                            Visibility="{Binding CanDismissAttention, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ui:TextBlock
                                            Foreground="#C75000"
                                            Text="{Binding ConsistencyText}"
                                            TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ui:TextBlock
                                        Margin="0,6,0,0"
                                        Opacity="0.6"
                                        Text="{Binding DataContext.RegistryMissingText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding IsPresentInRegistry, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ui:TextBlock
                                        Margin="0,6,0,0"
                                        Opacity="0.6"
                                        Text="{Binding DeletedAtText}"
                                        Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Orientation" Value="Vertical" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                    <Setter Property="Orientation" Value="Horizontal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <ui:Button Width="36" Height="36" Margin="0,0,8,0" Appearance="Secondary" Command="{Binding ManageSubMenuItemsCommand}" ToolTip="{Binding ManageSubMenuItemsToolTip}" Visibility="{Binding CanManageSubMenuItems, Converter={StaticResource BooleanToVisibilityConverter}}" Icon="{ui:SymbolIcon Symbol=Apps24}" />
                                        <ui:ToggleSwitch MinWidth="72" VerticalAlignment="Center" Content="{Binding ToggleLabel}" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" Visibility="{Binding ShowToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding DataContext.IsDetailedView, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ui:Button
                                        MinWidth="88"
                                        Padding="12,5"
                                        Command="{Binding DataContext.DeleteOrUndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Icon="{ui:SymbolIcon Symbol=Delete24}"
                                        Visibility="{Binding IsDeleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <ui:Button
                                        MinWidth="88"
                                        Padding="12,5"
                                        Command="{Binding DataContext.DeleteOrUndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding PrimaryActionLabel}"
                                        Icon="{ui:SymbolIcon Symbol=ArrowUndo24}"
                                        Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ui:DropDownButton
                                        MinWidth="88"
                                        Margin="0,8,0,0"
                                        Appearance="Secondary"
                                        VerticalAlignment="Center"
                                        Content="{Binding MoreActionsText}"
                                        Icon="{ui:SymbolIcon Symbol=MoreHorizontal24}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding HasActionFlyout, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ui:DropDownButton.Flyout>
                                            <ContextMenu
                                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem
                                                    Command="{Binding DeepAnalyzeMenuItemCommand}"
                                                    Header="{Binding DeepAnalyzeMenuItemText}"
                                                    Visibility="{Binding CanDeepAnalyzeMenuItem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.DeleteOrUndoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}"
                                                    Header="{Binding PlacementTarget.Tag.DeleteText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Visibility="{Binding IsDeleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.DeleteOrUndoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}"
                                                    Header="{Binding PrimaryActionLabel}"
                                                    Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.OpenPermanentDeleteFlyoutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}"
                                                    Header="{Binding PlacementTarget.Tag.PermanentDeleteText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    Visibility="{Binding CanPermanentlyDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Separator />
                                                <MenuItem
                                                    Command="{Binding PlacementTarget.Tag.OpenBatchManagementCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                    CommandParameter="{Binding}"
                                                    Header="{Binding PlacementTarget.Tag.BatchManagementText, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="{x:Type MenuItem}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CanOpenFileTypeBatchManagement}" Value="True" />
                                                                        <Condition Binding="{Binding PlacementTarget.Tag.HasBatchManagementAction, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                                <MenuItem Header="{Binding OtherAttributesTitle}" Visibility="{Binding HasOtherAttributesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem Header="{Binding OnlyWithShiftLabel}" IsCheckable="True" IsChecked="{Binding OnlyWithShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditShellAttributes}" />
                                                    <MenuItem Header="{Binding OnlyInExplorerLabel}" IsCheckable="True" IsChecked="{Binding OnlyInExplorer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditShellAttributes}" />
                                                    <MenuItem Header="{Binding NoWorkingDirectoryLabel}" IsCheckable="True" IsChecked="{Binding NoWorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditShellAttributes}" />
                                                    <MenuItem Header="{Binding NeverDefaultLabel}" IsCheckable="True" IsChecked="{Binding NeverDefault, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditShellAttributes}" />
                                                    <MenuItem Header="{Binding ShowAsDisabledIfHiddenLabel}" IsCheckable="True" IsChecked="{Binding ShowAsDisabledIfHidden, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditShellAttributes}" />
                                                </MenuItem>
                                                <MenuItem Header="{Binding DetailsTitle}" Visibility="{Binding HasDetailsActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <MenuItem Header="{Binding DetailsChangeTextLabel}" Command="{Binding ChangeTextCommand}" Visibility="{Binding CanEditText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsSearchOnline}" Command="{Binding SearchOnlineCommand}" Visibility="{Binding CanSearchOnline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsCommandTextLabel}" Command="{Binding ShowCommandTextCommand}" Visibility="{Binding HasCommandText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsFilePropertiesLabel}" Command="{Binding OpenFilePropertiesCommand}" Visibility="{Binding HasFileLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsFileLocationLabel}" Command="{Binding OpenFileLocationCommand}" Visibility="{Binding HasFileLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsRegistryLocationLabel}" Command="{Binding OpenRegistryLocationCommand}" Visibility="{Binding HasRegistryLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsExportRegistryLabel}" Command="{Binding ExportRegistryCommand}" Visibility="{Binding HasRegistryLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <MenuItem Header="{Binding DetailsClsidLocationLabel}" Command="{Binding OpenClsidLocationCommand}" Visibility="{Binding HasClsidLocation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </MenuItem>
                                            </ContextMenu>
                                        </ui:DropDownButton.Flyout>
                                    </ui:DropDownButton>
                                    <Grid
                                        Margin="0,8,0,0"
                                        Visibility="{Binding CanPermanentlyDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsCompactView, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Width" Value="0" />
                                                        <Setter Property="Height" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <ui:Flyout
                                            IsOpen="{Binding IsPermanentDeleteFlyoutOpen, Mode=TwoWay}"
                                            Placement="Top">
                                            <StackPanel Width="280">
                                                <ui:TextBlock
                                                    HorizontalAlignment="Left"
                                                    Text="{Binding PermanentDeleteConfirmationText}"
                                                    TextWrapping="Wrap" />
                                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                    <ui:Button
                                                        Margin="0,0,8,0"
                                                        Appearance="Primary"
                                                        Command="{Binding DataContext.ConfirmPermanentDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding DataContext.PermanentDeleteText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}" />
                                                    <ui:Button
                                                        Appearance="Secondary"
                                                        Command="{Binding ClosePermanentDeleteFlyoutCommand}"
                                                        Content="{Binding DataContext.CancelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Icon="{ui:SymbolIcon Symbol=Dismiss24}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ui:Flyout>
                                        <ui:Button
                                            MinWidth="88"
                                            Padding="12,5"
                                            Appearance="Secondary"
                                            Command="{Binding DataContext.OpenPermanentDeleteFlyoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding DataContext.PermanentDeleteText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Icon="{ui:SymbolIcon Symbol=DeleteDismiss24}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    Text="{Binding EmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding EmptyText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
            </Grid>
        </modernScroll:ModernScrollViewer>
    </Grid>
</UserControl>
