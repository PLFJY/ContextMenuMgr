<ui:FluentWindow x:Class="ContextMenuMgr.Frontend.Views.DetailedEditMenuWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{Binding Title}" Width="620" Height="620" MinWidth="460" MinHeight="400" WindowStartupLocation="CenterOwner">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ui:TitleBar Title="{Binding Title}"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding Group.Title}"/><TextBlock Margin="0,6,0,14" Opacity="0.68" Text="{Binding Group.RegistryPath}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Group.Rules}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,10" Padding="14" Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Margin="0,5,0,0" Opacity="0.72" Text="{Binding Tip}" TextWrapping="Wrap" Visibility="{Binding Tip, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/><ui:ToggleSwitch Margin="0,10,0,0" Content="{Binding DisplayName}" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsBooleanRule, Converter={StaticResource BooleanToVisibilityConverter}}"/><DockPanel Margin="0,10,0,0" Visibility="{Binding IsNumberRule, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBox MinWidth="140" Margin="0,0,8,0" Padding="10,6" DockPanel.Dock="Left" Text="{Binding NumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><ui:Button Padding="14,6" Command="{Binding ApplyCommand}" Content="{Binding ApplyText}" Icon="{ui:SymbolIcon Symbol=Checkmark24}"/></DockPanel><DockPanel Margin="0,10,0,0" Visibility="{Binding IsStringRule, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBox MinWidth="260" Margin="0,0,8,0" Padding="10,6" DockPanel.Dock="Left" Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><ui:Button Padding="14,6" Command="{Binding ApplyCommand}" Content="{Binding ApplyText}" Icon="{ui:SymbolIcon Symbol=Checkmark24}"/></DockPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></Grid>
</ui:FluentWindow>
