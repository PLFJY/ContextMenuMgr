<ui:FluentWindow x:Class="ContextMenuMgr.Frontend.Views.ShellSubMenuWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="{Binding Title}" Width="650" Height="520" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterOwner">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><ui:TitleBar Title="{Binding Title}"/>
    <ScrollViewer Grid.Row="1"><StackPanel Margin="18"><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ParentDisplayName}" TextWrapping="Wrap"/><ProgressBar Margin="0,14,0,0" Height="4" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Margin="0,8,0,0" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
      <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Opacity="0.65" Text="{Binding CommandText}" TextWrapping="Wrap"/></StackPanel><ui:ToggleSwitch Grid.Column="1" MinWidth="72" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggle}" Visibility="{Binding IsSeparator, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer></Grid>
</ui:FluentWindow>
