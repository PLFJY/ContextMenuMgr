<ui:FluentWindow
    x:Class="ContextMenuMgr.Frontend.DebugToolsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modernScroll="clr-namespace:ContextMenuMgr.Frontend.Controls.Modern.Scrolling"
    xmlns:behaviors="clr-namespace:ContextMenuMgr.Frontend.Behaviors"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="460"
    Height="620"
    MinWidth="420"
    MinHeight="300"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="CanResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Height="44"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image
                Grid.Column="0"
                Width="24"
                Height="24"
                Margin="12,0,10,0"
                VerticalAlignment="Center"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseDown="WindowIcon_MouseDown"
                Source="/Assets/AppIcon.ico" />

            <TextBlock
                x:Name="DebugTitleText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal">
                <ui:Button
                    Icon="{ui:SymbolIcon Symbol=Subtract24}"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource ChromeTitleBarButton}" />
                <ui:Button
                    x:Name="MaximizeButton"
                    Icon="{ui:SymbolIcon Symbol=Maximize24}"
                    Click="MaximizeButton_Click"
                    Style="{StaticResource ChromeTitleBarButton}" />
                <ui:Button
                    Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                    Click="CloseButton_Click"
                    Style="{StaticResource ChromeTitleBarButton}" />
            </StackPanel>
        </Grid>

        <modernScroll:ModernScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            x:Name="UpdatePromptTitleText"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <ui:Button
                            x:Name="ForceUpdatePromptButton"
                            Margin="0,14,0,0"
                            Padding="16,8"
                            Appearance="Secondary"
                            Click="OnForceUpdatePromptClick"
                            Icon="{ui:SymbolIcon Symbol=Alert24}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="OpenWithDebugTitleText" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="OpenWithDebugHelpText" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <WrapPanel>
                            <ui:Button x:Name="CreateOpenWithDebugButton" Margin="0,0,8,6" Padding="14,7"
                                       Click="OnCreateOpenWithDebugClick" />
                            <ui:Button x:Name="CleanupOpenWithDebugButton" Margin="0,0,0,6" Padding="14,7"
                                       Click="OnCleanupOpenWithDebugClick" />
                        </WrapPanel>
                        <TextBox x:Name="OpenWithDebugStatusText" Margin="0,6,0,0" IsReadOnly="True"
                                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                    </StackPanel>
                </Border>
                <Border Margin="0,14,0,0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="列表缓存与移除动画预览" />
                        <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="列表先显示缓存项，再演示发现新项和目标已删除时的动画。" TextWrapping="Wrap" />
                        <ui:Button x:Name="PlayMenuListPreviewButton" HorizontalAlignment="Left" Padding="14,7"
                                   Content="播放预览" Click="OnPlayMenuListPreviewClick" />
                        <ListBox x:Name="MenuListPreview" Margin="0,12,0,0" MaxHeight="250"
                                 Background="Transparent" BorderThickness="0"
                                 behaviors:MenuListTransitions.IsEnabled="True" ItemsSource="{Binding MenuListPreviewItems}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3" Padding="12,9" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Subtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </modernScroll:ModernScrollViewer>
    </Grid>
</ui:FluentWindow>
